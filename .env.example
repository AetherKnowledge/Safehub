# SafeHub local development environment
# Copy this file to .env when running the app locally with pnpm dev.
# For Docker deployment examples, use the .env.example files inside installations/.

############
# App URLs
############
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_nextauth_secret
AUTH_TRUST_HOST=TRUE
NEXT_PUBLIC_SHOW_CLIENT_LOGS=false

############
# Local services
############
# Use localhost values when Next.js runs on your host machine.
DATABASE_URL=postgresql://postgres:replace_with_postgres_password@localhost:10432/postgres
REDIS_URL=127.0.0.1
REDIS_PORT=11379

############
# Supabase
############
# Defaults assume you are running the self-hosted Supabase installation bundle.
# If you use Supabase Cloud or another external Supabase, replace these values.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:10000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret

############
# Google sign-in
############
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

############
# AI / automation
############
NEXT_PUBLIC_N8N_URL=
N8N_EMAIL_URL=
OPENAI_API_KEY=

############
# Optional TURN server for WebRTC calls
############
TURN_SERVER_URL=
TURN_SERVER_SECRET_KEY=
