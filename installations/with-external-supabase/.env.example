# SafeHub Docker install with external Supabase
# Copy this file to .env in this folder before running docker compose.
# Replace every placeholder with values from your Supabase project or deployment.

############
# App URLs
############
# Public URL where SafeHub is served.
NEXT_PUBLIC_URL=http://localhost:3000
# NextAuth callback/base URL. Usually the same as NEXT_PUBLIC_URL.
NEXTAUTH_URL=http://localhost:3000
# Random secret used by NextAuth. Generate a strong value for production.
NEXTAUTH_SECRET=replace_with_nextauth_secret
# Required when the app is behind Docker/proxies.
AUTH_TRUST_HOST=TRUE
# Set true only when you want browser console logs enabled.
NEXT_PUBLIC_SHOW_CLIENT_LOGS=false

############
# External Supabase
############
# Direct or pooler Postgres connection string from Supabase.
DATABASE_URL=postgresql://postgres:replace_with_password@replace_with_host:5432/postgres
# Supabase project API URL, for example https://your-project.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=https://replace_with_project_ref.supabase.co
# Supabase anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
# Supabase service-role key. Keep this server-side only.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# Supabase JWT secret from the project settings.
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret

############
# Google sign-in
############
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

############
# AI / automation
############
NEXT_PUBLIC_N8N_URL=
N8N_EMAIL_URL=
OPENAI_API_KEY=

############
# Optional TURN server for WebRTC calls
############
TURN_SERVER_URL=
TURN_SERVER_SECRET_KEY=
