# SafeHub Docker install without external Supabase
# Copy this file to .env in this folder before running docker compose.
# Values in this file are development defaults. Replace every secret before production.

# App URLs
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_nextauth_secret
AUTH_TRUST_HOST=TRUE
NEXT_PUBLIC_SHOW_CLIENT_LOGS=false

# AI / automation webhooks
NEXT_PUBLIC_N8N_URL=
N8N_EMAIL_URL=
OPENAI_API_KEY=

# Optional TURN server for WebRTC calls
TURN_SERVER_URL=
TURN_SERVER_SECRET_KEY=

# Redis
# In Docker this should be the redis service name. For host-only local dev use 127.0.0.1.
REDIS_URL=redis
REDIS_PORT=6379

# SafeHub database connection
# Default assumes you are using the locally hosted Supabase database from docker-compose.yml.
# If you use Supabase Cloud or another external Supabase instance, replace this with that project's direct or pooler Postgres connection string.
DATABASE_URL=postgresql://postgres:replace_with_postgres_password@db:5432/postgres

# Supabase client values used by the Next.js app
# For full local Docker compose, these point at Kong on your machine.
# For Supabase Cloud/external Supabase, replace with your project API URL and keys.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:10000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret

# Google sign-in for SafeHub / Supabase Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase self-hosted stack
# Password for the local Supabase Postgres superuser.
POSTGRES_PASSWORD=replace_with_postgres_password
# JWT secret used by Supabase Auth, PostgREST, Realtime, Storage, and Kong.
JWT_SECRET=replace_with_supabase_jwt_secret
# Public anon JWT for browser/client requests.
ANON_KEY=replace_with_supabase_anon_key
# Private service-role JWT for trusted server-side actions.
SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# Username for the Supabase Studio basic-auth prompt through Kong.
DASHBOARD_USERNAME=supabase
# Password for the Supabase Studio basic-auth prompt through Kong.
DASHBOARD_PASSWORD=replace_with_dashboard_password
# Secret used by Realtime/Supavisor internals. Use a long random value in production.
SECRET_KEY_BASE=replace_with_secret_key_base
# 32-character key used by Supabase Vault encryption.
VAULT_ENC_KEY=change_me_vault_key_32_chars_000
# 32-character key used by Postgres Meta encryption.
PG_META_CRYPTO_KEY=change_me_pg_meta_key_32_chars_0

############
# Database
############
# Internal Docker hostname for the Supabase Postgres container.
POSTGRES_HOST=db
# Database name created by the Supabase Postgres container.
POSTGRES_DB=postgres
# Internal Postgres port inside the Docker network.
POSTGRES_PORT=5432

############
# Supavisor -- Database pooler
############
# Port Supavisor listens on for transaction pooling connections.
POOLER_PROXY_PORT_TRANSACTION=6543
# Default number of database connections each pool can keep open.
POOLER_DEFAULT_POOL_SIZE=20
# Maximum number of client connections accepted by Supavisor.
POOLER_MAX_CLIENT_CONN=100
# Tenant identifier used by Supavisor for the local Supabase project.
POOLER_TENANT_ID=stub
# Number of Postgres connections Supavisor opens for the pool.
POOLER_DB_POOL_SIZE=5
# Host port exposed for direct Supavisor Postgres connections.
SUPAVISOR_POSTGRES_PORT=15432

############
# Kong -- Supabase API gateway
############
# Host HTTP port for Supabase API / Studio through Kong.
KONG_HTTP_PORT=10000
# Host HTTPS port for Kong, if TLS is configured.
KONG_HTTPS_PORT=10443
# Public URL that Studio and SafeHub should use for the self-hosted Supabase API.
SUPABASE_PUBLIC_URL=http://localhost:10000
# Main SafeHub app URL used by Supabase Auth redirects.
SITE_URL=http://localhost:3000
# External Supabase Auth API URL exposed through Kong.
API_EXTERNAL_URL=http://localhost:10000
# Additional redirect URLs allowed by Supabase Auth.
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**
# Supabase GoTrue redirect allow-list.
GOTRUE_URI_ALLOW_LIST=http://localhost:3000/**

############
# PostgREST / Auth
############
# Database schemas exposed by PostgREST.
PGRST_DB_SCHEMAS=public,storage,graphql_public
# JWT expiration in seconds.
JWT_EXPIRY=3600
# Set true to prevent new users from signing up through Supabase Auth.
DISABLE_SIGNUP=false

############
# Auth providers and email
############
# Enable email/password signups in Supabase Auth.
ENABLE_EMAIL_SIGNUP=true
# Automatically confirm email signups in development.
ENABLE_EMAIL_AUTOCONFIRM=true
# Allow anonymous Supabase users.
ENABLE_ANONYMOUS_USERS=false
# Enable phone signups in Supabase Auth.
ENABLE_PHONE_SIGNUP=false
# Automatically confirm phone signups in development.
ENABLE_PHONE_AUTOCONFIRM=false

# Email address shown as the Supabase Auth admin/sender address.
SMTP_ADMIN_EMAIL=admin@example.com
# SMTP server hostname used by Supabase Auth.
SMTP_HOST=inbucket
# SMTP server port used by Supabase Auth.
SMTP_PORT=2500
# SMTP username, if required by your mail provider.
SMTP_USER=
# SMTP password, if required by your mail provider.
SMTP_PASS=
# Sender display name for auth emails.
SMTP_SENDER_NAME=SafeHub
# Supabase Auth email confirmation path.
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
# Supabase Auth invite email path.
MAILER_URLPATHS_INVITE=/auth/v1/verify
# Supabase Auth password recovery email path.
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
# Supabase Auth email-change confirmation path.
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Google OAuth for Supabase Auth
############
# Enable Google OAuth in the self-hosted Supabase Auth service.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
# Google OAuth client ID for Supabase Auth.
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
# Google OAuth client secret for Supabase Auth.
GOTRUE_EXTERNAL_GOOGLE_SECRET=
# Google OAuth redirect URI handled by Supabase Auth through Kong.
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:10000/auth/v1/callback

############
# Supabase Studio / Storage / Functions / Logs
############
# Organization name shown in Supabase Studio.
STUDIO_DEFAULT_ORGANIZATION=SafeHub
# Project name shown in Supabase Studio.
STUDIO_DEFAULT_PROJECT=SafeHub Local
# Allow imgproxy to detect and serve WebP images when supported.
IMGPROXY_ENABLE_WEBP_DETECTION=true
# Require JWT verification for the bundled local edge function.
FUNCTIONS_VERIFY_JWT=false
# Public token used by Logflare/vector for analytics logs.
LOGFLARE_PUBLIC_ACCESS_TOKEN=replace_with_logflare_public_token
# Private token used by Logflare.
LOGFLARE_PRIVATE_ACCESS_TOKEN=replace_with_logflare_private_token
# Docker socket path mounted into Vector so it can read container logs.
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
# Optional Google Cloud project ID if using BigQuery analytics.
GOOGLE_PROJECT_ID=
# Optional Google Cloud project number if using BigQuery analytics.
GOOGLE_PROJECT_NUMBER=
